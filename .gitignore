# Large data — download/regenerate locally, never commit (see README)
data/raw_fastq/
data/fastq_trimmed/

# Reference sequences (downloaded from GENCODE); keep the small derived maps
data/reference/*.fa.gz
data/reference/*.fasta.gz
data/reference/*.gtf.gz
data/reference/*.genome.fa.gz

# Salmon index and per-sample quantifications (regenerated by the notebook)
data/salmon_index_v112_utf8/
data/salmon_quants/
data/salmon_quants_rawreads_archive/

# Environment, caches, logs
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
logs/
.pytest_cache/

# Documentation
*.docx

# OS / editor cruft
.DS_Store
Thumbs.db

# Word/Office temporary lock files
~$*

# Excluded outlier sample (heavy reads, kept locally only)
data/_excluded_*/

# STRING precomputed interactome (downloaded on demand by the notebook)
data/reference/9606.protein.*.txt.gz

# Local-only files 
_local_notes/
